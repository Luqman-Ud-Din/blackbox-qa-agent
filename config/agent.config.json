{
  "apps": [
    {
      "name": "my-app",
      "baseUrl": "http://localhost:3000",
      "auth": {
        "enabled": false,
        "loginRoute": "/login",
        "method": "form",
        "credentials": {
          "emailEnvVar": "APP_EMAIL",
          "passwordEnvVar": "APP_PASSWORD"
        },
        "selectors": {
          "emailField": "input[type='email'], input[name='email']",
          "passwordField": "input[type='password']",
          "submitButton": "button[type='submit']"
        },
        "success": {
          "urlContains": "/dashboard",
          "elementVisible": "",
          "timeoutMs": 5000
        },
        "failure": {
          "urlContains": "/login",
          "elementVisible": ".error, [role='alert']"
        }
      },
      "routes": {
        "discover": true,
        "include": [],
        "exclude": []
      },
      "interactions": {
        "enabled": true,
        "scenariosDir": "./scenarios"
      }
    }
  ],
  "browsers": [
    "chromium",
    "firefox",
    "webkit"
  ],
  "viewports": [
    {
      "name": "mobile",
      "width": 375,
      "height": 812
    },
    {
      "name": "tablet",
      "width": 768,
      "height": 1024
    },
    {
      "name": "laptop",
      "width": 1366,
      "height": 768
    },
    {
      "name": "desktop",
      "width": 1920,
      "height": 1080
    }
  ],
  "skills": {
    "qa-inspect-typography": {
      "enabled": true
    },
    "qa-inspect-layout": {
      "enabled": true
    },
    "qa-inspect-a11y": {
      "enabled": true
    },
    "qa-inspect-images": {
      "enabled": true
    },
    "qa-inspect-forms": {
      "enabled": true
    },
    "qa-inspect-interactions": {
      "enabled": true
    },
    "qa-inspect-content": {
      "enabled": true
    },
    "qa-inspect-network": {
      "enabled": true
    },
    "qa-inspect-console": {
      "enabled": true
    },
    "qa-inspect-performance": {
      "enabled": false
    },
    "qa-inspect-functional-forms": {
      "enabled": true
    },
    "qa-inspect-functional-navigation": {
      "enabled": true
    },
    "qa-inspect-functional-filters": {
      "enabled": true
    },
    "qa-inspect-functional-search": {
      "enabled": true
    },
    "qa-inspect-functional-state": {
      "enabled": true
    }
  },
  "tickets": {
    "provider": "markdown",
    "providers": {
      "markdown": {
        "outputPath": "./tickets.md"
      },
      "jira": {
        "host": "",
        "project": "",
        "credentialsEnvVar": "JIRA_TOKEN"
      },
      "ado": {
        "org": "",
        "project": "",
        "credentialsEnvVar": "ADO_PAT"
      }
    }
  }
}
