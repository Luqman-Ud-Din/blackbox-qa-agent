{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--isolated",
        "--browser",
        "chromium",
        "--output-dir",
        ".tmp/.playwright-mcp"
      ]
    },
    "pw-chromium-mobile": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--isolated",
        "--browser",
        "chromium",
        "--device",
        "iPhone 12",
        "--output-dir",
        ".tmp/.playwright-mcp"
      ]
    },
